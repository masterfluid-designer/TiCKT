# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
TICKET_BASE_URL=https://tickets.yourdomain.com

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/ticketflow?schema=public"

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# ─── Kkiapay (Paiement) ──────────────────────────────────────────────────────
KKIAPAY_PUBLIC_KEY=your_kkiapay_public_key
KKIAPAY_PRIVATE_KEY=your_kkiapay_private_key
KKIAPAY_SECRET_KEY=your_kkiapay_secret_key
KKIAPAY_SANDBOX=true
KKIAPAY_WEBHOOK_SECRET=your_webhook_secret

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@email.com
SMTP_PASS=your-app-password
EMAIL_FROM="TicketFlow <noreply@yourdomain.com>"

# ─── WhatsApp ────────────────────────────────────────────────────────────────
WHATSAPP_API_URL=https://api.whatsapp.com/v1
WHATSAPP_TOKEN=your_whatsapp_token
WHATSAPP_PHONE_ID=your_phone_number_id

# ─── Storage (S3-compatible) ─────────────────────────────────────────────────
STORAGE_PROVIDER=local
# Pour S3/R2 :
# STORAGE_PROVIDER=s3
# AWS_ACCESS_KEY_ID=your_key
# AWS_SECRET_ACCESS_KEY=your_secret
# AWS_REGION=us-east-1
# AWS_BUCKET=ticketflow-assets
# AWS_ENDPOINT=https://xxx.r2.cloudflarestorage.com  # pour Cloudflare R2

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Logs ────────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
